{
  "name": "voicevox-mcp",
  "version": "0.1.0",
  "description": "MCP server for VOICEVOX: text-to-speech and singing (multi-track songs) for AI agents",
  "type": "module",
  "bin": {
    "voicevox-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@sevenc-nanashi/utaformatix-ts": "npm:@jsr/sevenc-nanashi__utaformatix-ts@^0.4.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tonejs/midi": "^2.0.28",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
